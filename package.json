{
  "name": "chamaone",
  "private": true,
  "version": "1.5.4",
  "type": "module",
  "description": "ChamaOne — Chama & savings-group manager. Built in the EduOne mobile style (React + Capacitor).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mobile:build": "vite build && cap sync",
    "android:add": "cap add android",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:run": "vite build && cap sync android && cap run android",
    "assets": "capacitor-assets generate --android",
    "android:apk": "npm run build && npx cap sync android && capacitor-assets generate --android && node scripts/stamp-android-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
