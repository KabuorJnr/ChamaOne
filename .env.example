# ChamaOne — environment configuration
# Copy this file to `.env` and fill in your Supabase project values.
# Vite only exposes vars prefixed with VITE_ to the client bundle.
#
# The anon (public) key is safe to ship in a client app — it is protected by
# Row Level Security. NEVER put the service_role key here or anywhere in the
# frontend.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL used in member invite links (optional).
# Defaults to the current web origin; set it for native/APK builds.
VITE_PUBLIC_URL=https://your-app.vercel.app
