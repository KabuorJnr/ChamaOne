{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/ChamaOne.apk",
      "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }]
    }
  ]
}
